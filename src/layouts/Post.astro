---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { formatDate, isoDate, readingTime, slugifyTag } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = readingTime(post.body);
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
>
  <article class="shell">
    <header class="masthead">
      <p class="meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {
        updatedDate && (
          <p class="updated">
            Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
          </p>
        )
      }
    </header>

    <hr class="rule" />

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <nav class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
          ))}
        </nav>
      )
    }

    {
      (prev || next) && (
        <nav class="pager" aria-label="More posts">
          {next ? (
            <a class="pager-link" href={`/writing/${next.id}/`}>
              <span class="eyebrow">Newer</span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {prev && (
            <a class="pager-link end" href={`/writing/${prev.id}/`}>
              <span class="eyebrow">Older</span>
              <span class="pager-title">{prev.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .masthead {
    max-width: var(--measure);
  }

  .meta {
    display: flex;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-block-end: 0.9rem;
  }

  .masthead h1 {
    font-size: var(--step-3);
  }

  .dek {
    margin-block-start: 0.85rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .updated {
    margin-block-start: 0.8rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .rule {
    margin-block: 2.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 3rem;
  }

  .tags a {
    padding: 0.25em 0.75em;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-soft);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .tags a:hover {
    background: var(--moss-wash);
    border-color: var(--moss);
    color: var(--moss-deep);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-block-start: 3.5rem;
    padding-block-start: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
  }

  .pager-link.end {
    text-align: right;
    grid-column: 2;
  }

  .pager-title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 55, 'WONK' 1, 'opsz' 20;
    font-weight: 600;
    line-height: 1.3;
  }

  .pager-link:hover .pager-title {
    color: var(--moss-deep);
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.end {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
