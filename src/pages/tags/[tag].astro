---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { sortPosts, collectTags, slugifyTag } from '../../utils';

export const getStaticPaths = (async () => {
  const posts = sortPosts(await getCollection('blog'));

  return collectTags(posts).map(({ tag }) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<Base
  title={`Tagged “${tag}”`}
  description={`Posts tagged ${tag}.`}
>
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">Tagged</p>
      <h1>{tag}</h1>
      <p class="count">
        {posts.length}
        {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </header>

    <div class="list">
      {posts.map((post) => <PostRow post={post} />)}
    </div>

    <p class="back"><a href="/writing">← All writing</a></p>
  </div>
</Base>

<style>
  .page-head h1 {
    font-size: var(--step-3);
    margin-block-start: 0.5rem;
  }

  .count {
    margin-block-start: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .list {
    margin-block-start: 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .back {
    margin-block-start: 2.5rem;
    font-size: var(--step--1);
  }

  .back a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .back a:hover {
    color: var(--moss-deep);
  }
</style>
